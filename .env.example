# =============================================================================
#  MeshVPN — Environment Variables
# =============================================================================
#
#  LOCAL DEV:  copy this file to .env, fill in values, run docker compose up
#  PORTAINER:  paste these as "Environment variables" in the stack editor
#
# =============================================================================

# ── Node identity (REQUIRED) ──────────────────────────────────────────────────
MESH_NODE_NAME=node-a
MESH_PUBLIC_IP=192.168.1.10        # this server's public or LAN IP
# If this node is behind a reverse proxy (NPM, Traefik, Caddy), set the full
# public URL peers should use to reach the API. Leave unset for direct IP access.
# MESH_API_URL=https://vpn.example.com

# ── Admin password ────────────────────────────────────────────────────────────
ADMIN_PASSWORD=changeme            # used to log into the web UI

# ── Mesh mode ─────────────────────────────────────────────────────────────────
MESH_MODE=leader                   # "leader" for first node, "join" for all others

# For join mode only — get the token from Node A → Servers → Add server:
# MESH_MODE=join
# MESH_JOIN_ADDR=NODE_A_IP:8080           # plain IP (uses http://)
# MESH_JOIN_ADDR=https://vpn.example.com # full URL when leader is behind NPM/proxy
# MESH_JOIN_TOKEN=paste-token-here
# MESH_JOIN_SSL_VERIFY=true               # set false only for self-signed certs

# ── Ports (change if you have conflicts) ─────────────────────────────────────
MESH_API_PORT=8080
MESH_UI_PORT=3000
MESH_WG_PORT=51820
MESH_VPN_PORT=443
MESH_PRIORITY=100                  # higher = preferred leader (node-b should be 50)

# ── Subnets — must be identical on every node ─────────────────────────────────
MESH_CLIENT_SUBNET=10.8.0.0/24
MESH_SUBNET=10.99.0.0/24
MESH_ALLOWED_LAN=192.168.100.0/24

# ── Routing ───────────────────────────────────────────────────────────────────
MESH_ROUTING_MODE=weighted         # weighted | random | fastest | failover
MESH_ROUTING_WEIGHT=100
MESH_HEALTH_INTERVAL=3
MESH_FAILOVER_THRESHOLD=3

# ── Optional services (comma-separated list of profiles to activate) ──────────
# Leave blank for core + frontend only (recommended for initial testing).
# Full stack: COMPOSE_PROFILES=wg,openvpn,haproxy,cloudflare,router
COMPOSE_PROFILES=

# ── Cloudflare DNS (optional — requires profile "cloudflare") ─────────────────
CF_ENABLED=false
CF_API_TOKEN=
CF_ZONE_ID=
CF_DOMAIN=vpn.yourdomain.com
CF_TTL=60
