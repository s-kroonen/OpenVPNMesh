# =============================================================================
#  MeshVPN — Environment Variables
# =============================================================================
#
#  LOCAL DEV:  copy this file to .env, fill in values, run docker compose up
#  PORTAINER:  paste these as "Environment variables" in the stack editor
#
# =============================================================================

# ── Node identity (REQUIRED) ──────────────────────────────────────────────────
MESH_NODE_NAME=node-a
MESH_PUBLIC_IP=192.168.1.10        # this server's public or LAN IP
# If this node is behind a reverse proxy (NPM, Traefik, Caddy), set the full
# public URL peers should use to reach the API. Leave unset for direct IP access.
# MESH_API_URL=https://vpn.example.com

# ── Admin password ────────────────────────────────────────────────────────────
ADMIN_PASSWORD=changeme            # used to log into the web UI

# ── Mesh mode ─────────────────────────────────────────────────────────────────
MESH_MODE=leader                   # "leader" for first node, "join" for all others

# For join mode only — get the token from Node A → Servers → Add server:
# MESH_MODE=join
# MESH_JOIN_ADDR=NODE_A_IP:8080           # plain IP (uses http://)
# MESH_JOIN_ADDR=https://vpn.example.com # full URL when leader is behind NPM/proxy
# MESH_JOIN_TOKEN=paste-token-here
# MESH_JOIN_SSL_VERIFY=true               # set false only for self-signed certs

# ── Ports (change if you have conflicts) ─────────────────────────────────────
MESH_API_PORT=8080
MESH_UI_PORT=3000
MESH_WG_PORT=51820
MESH_VPN_PORT=443
MESH_PRIORITY=100                  # higher = preferred leader (node-b should be 50)

# ── Where the browser hits the API ────────────────────────────────────────────
# Leave EMPTY (default) to use the frontend container's built-in nginx proxy
# that forwards /api/ to the core service on the docker network. This is what
# you want in most deployments.
#
# Set to an absolute URL when frontend and API are served from different
# origins — the SPA will hit that URL directly instead of the proxy. Examples:
#   API_URL=http://localhost:8080         local dev, browser talks to core directly
#   API_URL=https://vpn.example.com       behind a reverse proxy (NPM, Traefik)
# API_URL=

# ── CORS allow-list ───────────────────────────────────────────────────────────
# When API_URL points to a different origin than the frontend, the browser
# enforces CORS. localhost:3000 / localhost:8080 (and 127.0.0.1 variants) plus
# MESH_API_URL are always allowed. Add any other frontend origins here as a
# comma-separated list. Use "*" to allow everything (dev only, not with creds).
#   MESH_CORS_ORIGINS=http://192.168.1.50:3000,https://vpn.example.com
# MESH_CORS_ORIGINS=

# ── Subnets — must be identical on every node ─────────────────────────────────
MESH_CLIENT_SUBNET=10.8.0.0/24
MESH_SUBNET=10.99.0.0/24
MESH_ALLOWED_LAN=192.168.100.0/24

# ── Routing ───────────────────────────────────────────────────────────────────
MESH_ROUTING_MODE=weighted         # weighted | random | fastest | failover
MESH_ROUTING_WEIGHT=100
MESH_HEALTH_INTERVAL=3
MESH_FAILOVER_THRESHOLD=3

# ── Optional services ─────────────────────────────────────────────────────────
# Set each to "true" to enable. Default is false (container starts then exits).
# Works in Portainer, Swarm, and local docker compose — no profile magic needed.
# Recommended bring-up order: start with all false, confirm core+frontend work,
# then enable wg → openvpn → haproxy → router → cloudflare one at a time.
ENABLE_WG=false
ENABLE_OPENVPN=false
ENABLE_HAPROXY=false
ENABLE_ROUTER=false
ENABLE_CLOUDFLARE=false

# ── Cloudflare DNS (optional — requires profile "cloudflare") ─────────────────
CF_ENABLED=false
CF_API_TOKEN=
CF_ZONE_ID=
CF_DOMAIN=vpn.yourdomain.com
CF_TTL=60
